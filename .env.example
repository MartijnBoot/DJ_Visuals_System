# ============================================================================
# The environment contract (way-of-working 3.3, spec SD6, B-12 SD14).
# Copy to .env.local (scripts/setup.sh does) and fill in. NEVER commit real values.
# The first six variables are required; there are no defaults in code. They are validated at
# boot by server/src/config.ts, the one module that reads the environment; a missing or
# malformed value is one fatal log line naming the variable (never its value) and a non-zero
# exit. The run scripts load this file from the repository root, so a relative DATA_DIR
# resolves against the root.
# Anything prefixed VITE_ is shipped to the browser: never a secret.
# ============================================================================

APP_ENV=development            # development | test | production
LOG_LEVEL=debug                # debug | info | warn | error
APP_MODE=local                 # local (the install on the screen machine) | hosted (the cloud)
PORT=8000                      # the server listens on 127.0.0.1:PORT (not configurable)
CONTROL_PORT=8001              # the External control listener's port; nothing listens on it until
                               # switched on; must differ from PORT
DATA_DIR=./data                # holds djvisuals.sqlite and assets/; created at boot

# ----------------------------------------------------------------------------
# The cloud (B-12). URLs are https, or http on 127.0.0.1 / localhost only. An empty value counts
# as not set.
#
# APP_MODE=local: these three together, or none of them. With none, the install never talks to
# the cloud and the panel shows no cloud row. The two OIDC values are public (the provider's
# issuer URL and its public client id), but are still never committed here: keep them in
# .env.local.
#   CLOUD_URL=                 # the cloud's address, e.g. https://<domain>
#   OIDC_ISSUER=               # the sign-in provider's issuer URL (its discovery document's `issuer`)
#   OIDC_CLIENT_ID=            # the provider's public client id (PKCE, no secret)
#
# APP_MODE=hosted: OIDC_ISSUER, OIDC_CLIENT_ID and ALLOWED_SUBJECT are required; CLOUD_URL is
# refused. They belong in the VM's env file (/etc/djvisuals/env), never in this repository.
#   ALLOWED_SUBJECT=           # the `sub` of the one account allowed in; any other gets 403
# ----------------------------------------------------------------------------
