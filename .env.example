# ============================================================================
# The environment contract (way-of-working 3.3, Appendix B).
# Copy to .env.local (scripts/setup.sh does) and fill in. NEVER commit real values.
# Every variable here is validated at boot by the one config module; nothing else reads the
# environment. Adding a variable is a three-file change: this file, the config schema, and the
# deployment parameters.
# Anything prefixed VITE_ / NEXT_PUBLIC_ is shipped to the browser: never a secret.
# ============================================================================

# --- Runtime ------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=debug                # debug | info | warn | error
PORT=8000

# --- Database -----------------------------------------------------------------
# Local only: a published development credential, not a secret.
# DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app_dev

# --- Secrets (empty here; real values local-only or in the vault) -------------
# SESSION_SECRET=              # 32+ random bytes
