# ============================================================================
# The environment contract (way-of-working 3.3, spec SD6).
# Copy to .env.local (scripts/setup.sh does) and fill in. NEVER commit real values.
# All four variables are required; there are no defaults in code. They are validated at boot by
# server/src/config.ts, the one module that reads the environment; a missing or malformed value
# is one fatal log line and a non-zero exit. The run scripts load this file from the repository
# root, so a relative DATA_DIR resolves against the root.
# Anything prefixed VITE_ is shipped to the browser: never a secret.
# ============================================================================

APP_ENV=development            # development | test | production
LOG_LEVEL=debug                # debug | info | warn | error
PORT=8000                      # the server listens on 127.0.0.1:PORT (not configurable)
DATA_DIR=./data                # holds djvisuals.sqlite and assets/; created at boot
